    "NSCalendarsUsageDescription" : {
      "comment" : "Privacy - Calendars Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lamo reads your calendar to show events and find free time slots."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lamo читает ваш календарь, чтобы показывать события и находить свободные интервалы времени."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
